# Core runtime
AUTOMAIN_DB_PATH=./data/automain.db
# Metadata-only passage catalog; must differ from source and legacy files.
# Unset this to default to index.db beside AUTOMAIN_DB_PATH / --db.
AUTOMAIN_INDEX_DB_PATH=./data/index.db
# Deprecated legacy source only; never opened automatically or written.
# Migrate explicitly: automain index migrate --repo owner/name --from /path/to/vectors.db
# AUTOMAIN_VECTOR_DB_PATH=/path/to/vectors.db
AUTOMAIN_REPO=
# Legacy analysis finder: llm | fts | vector (TF-IDF, not embedding search)
AUTOMAIN_FINDER=llm
AUTOMAIN_LISTEN_ADDR=127.0.0.1:8080

# Qdrant gRPC; Compose overrides host to qdrant. Remote/public hosts require TLS.
AUTOMAIN_QDRANT_HOST=127.0.0.1
AUTOMAIN_QDRANT_PORT=6334
AUTOMAIN_QDRANT_TLS=false
AUTOMAIN_QDRANT_API_KEY=
AUTOMAIN_QDRANT_COLLECTION_PREFIX=automain_

# GitHub (token required for Discussions sync; optional for public issues/PRs)
GITHUB_TOKEN=

# Embeddings only: google/gemini-embedding-2 through OpenRouter
# This is the only supported embedding model; other values are rejected.
AUTOMAIN_EMBEDDING_MODEL=google/gemini-embedding-2
# Full-size vectors by default; supported output range: 128-3072.
AUTOMAIN_EMBEDDING_DIMENSIONS=3072
AUTOMAIN_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Add your real key locally. Never commit it.
OPENROUTER_API_KEY=
# Optional dedicated embedding key takes precedence over OPENROUTER_API_KEY.
# AUTOMAIN_EMBEDDING_API_KEY=

# Typed decisions through OpenRouter (Jev, not a chat/LLM model)
# Pinned release; probabilities/thresholds must be rechecked when changing models.
AUTOMAIN_DECISION_MODEL=typesafe/jev-1.14
# Full endpoint, NOT the embedding /api/v1 base URL.
AUTOMAIN_DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# Optional dedicated key takes precedence over OPENROUTER_API_KEY above.
# AUTOMAIN_DECISION_API_KEY=

# Legacy analysis only, independent of embeddings: gemini | openai | deepseek
AUTOMAIN_LLM_PROVIDER=gemini

# Gemini (when AUTOMAIN_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (when AUTOMAIN_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (when AUTOMAIN_LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat         # deepseek-chat | deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
