# Core runtime
AUTOMAIN_DB_PATH=./data/automain.db
# Metadata-only catalog; separate from source data.
AUTOMAIN_INDEX_DB_PATH=./data/index.db
AUTOMAIN_REPO=
# llm | fts | vector (TF-IDF)
AUTOMAIN_FINDER=llm
AUTOMAIN_LISTEN_ADDR=127.0.0.1:8080

# Qdrant (gRPC; remote hosts require TLS)
# API key required by Compose.
AUTOMAIN_QDRANT_HOST=127.0.0.1
AUTOMAIN_QDRANT_PORT=6334
AUTOMAIN_QDRANT_TLS=false
AUTOMAIN_QDRANT_API_KEY=
AUTOMAIN_QDRANT_COLLECTION_PREFIX=automain_

# GitHub
GITHUB_TOKEN=

# Embeddings (OpenRouter)
AUTOMAIN_EMBEDDING_MODEL=google/gemini-embedding-2
AUTOMAIN_EMBEDDING_DIMENSIONS=3072
AUTOMAIN_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Shared OpenRouter key (chat, embeddings, decisions)
OPENROUTER_API_KEY=
# Optional override
# AUTOMAIN_EMBEDDING_API_KEY=

# Jev decisions
AUTOMAIN_DECISION_MODEL=typesafe/jev-1.14
AUTOMAIN_DECISION_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# Optional override
# AUTOMAIN_DECISION_API_KEY=

# LLM: openrouter | gemini | openai | deepseek
AUTOMAIN_LLM_PROVIDER=openrouter
# Overrides for the selected provider
AUTOMAIN_LLM_API_KEY=
AUTOMAIN_LLM_MODEL=
AUTOMAIN_LLM_BASE_URL=
# AUTOMAIN_LLM_API_URL=

# OpenRouter chat
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_URL=

# Direct Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_URL=

# Direct OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_URL=

# Direct DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_URL=
