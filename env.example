# Core runtime
AUTOMAIN_DB_PATH=./data/automain.db
AUTOMAIN_REPO=
AUTOMAIN_FINDER=llm                  # llm | fts | vector
AUTOMAIN_LISTEN_ADDR=127.0.0.1:8080

# GitHub (token required for Discussions sync; optional for public issues/PRs)
GITHUB_TOKEN=

# Active LLM provider: gemini | openai | deepseek
AUTOMAIN_LLM_PROVIDER=gemini

# Gemini (when AUTOMAIN_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (when AUTOMAIN_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (when AUTOMAIN_LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat         # deepseek-chat | deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com
