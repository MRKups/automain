# Path to the SQLite database file
AUTOMAIN_DB_PATH=./data/automain.db

# Default GitHub repository in owner/name format (optional; can be passed via --repo)
AUTOMAIN_REPO=

# GitHub Personal Access Token for higher rate limits and GraphQL discussions access
GITHUB_TOKEN=

# LLM API credentials for candidate discovery and relationship analysis
AUTOMAIN_LLM_API_KEY=
GEMINI_API_KEY=

# Model identifier for structured inference
AUTOMAIN_LLM_MODEL=gemini-2.5-flash

# Candidate discovery strategy: llm | fts | vector
AUTOMAIN_FINDER=llm

# HTTP server listen address for 'automain serve' (Railway sets PORT automatically)
AUTOMAIN_LISTEN_ADDR=127.0.0.1:8080
